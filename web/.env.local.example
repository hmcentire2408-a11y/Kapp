# Copy to .env.local and fill in. .env.local is gitignored — never commit these.

# --- Anthropic ---------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship the key
# to every browser that loads the page.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ----------------------------------------------------------
# From the Supabase dashboard: Project Settings -> API.
# The anon key is safe in the browser: row-level security is what protects
# the data, and every policy is `auth.uid() = user_id`.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Optional. Defaults shown. -----------------------------------------
# KAPP_MODEL=claude-opus-5
# KAPP_EFFORT=high          # low | medium | high | xhigh | max
# KAPP_WEB_SEARCH=on        # on | off — deprioritized either way; policy facts only
